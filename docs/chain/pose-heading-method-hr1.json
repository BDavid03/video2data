 "inputs": {
  "observed": "frame-0 calibrated stereo rgb_depth_m points inside the recorded object mask (assignments.json clusters), valid & finite & >0",
  "table": "RANSAC (400 iters, 4 mm inlier, within 0.35 m of objects, normal within 20 deg of recorded MoGe plane normal) + SVD refit on stereo background pixels; normal oriented toward the camera",
  "scan": "trimesh.load(force=mesh, process=False); trimesh.sample.sample_surface 20000 points, seed 0"
 },
 "prefilter": {
  "min_height_above_table_m": 0.005,
  "max_horizontal_radius_from_median_m": 0.09,
  "max_observed_points": 4000,
  "seed": 0
 },
 "candidates": {
  "up_axis_candidates": [
   "scan +z",
   "scan -z"
  ],
  "yaw_step_deg": 5,
  "yaw_range_deg": [
   0,
   360
  ],
  "rotation": "R = B^T Rz(yaw) A_up, B = table_basis(normal) rows (x, y, n), A_up = I or diag(1,-1,-1)",
  "init_translation": "observed centroid, pushed 0.02 m horizontally away from camera, lowest model point on the table plane"
 },
 "icp": {
  "pairs": "observed -> nearest scan sample (cKDTree in scan frame)",
  "keep_fraction": 0.8,
  "translation_only_iters": 10,
  "rigid_iters": 25,
  "rigid_update": "Kabsch on kept pairs (unconstrained small rotation; observed drift < 3 deg yaw, tilt 2-7 deg)"
 },
 "loss": "trimmed mean (80 %) observed->scan nearest-sample distance at the final pose (mm)",
 "selection": {
  "up_axis": "the sign whose curve minimum is lower; declined if the other sign is within 5%",
  "yaw": "final ICP pose of the lowest-loss start on the 5-degree grid",
  "confidence": "declined (object treated as yaw-ambiguous) if any other local minimum whose final yaw differs by more than 30 deg from the best has loss within 3% of the best",
  "margin": 0.03,
  "separation_deg": 30.0,
  "up_margin": 0.05,
  "rationale": "On episode 11, four parameter perturbations (keep 0.6/0.9, no push-back, longer ICP) move the best basin by up to the spreads below at relative loss changes of 1-2 %; a 3 % margin is the smallest that exceeds that parameter-induced noise. Under this rule both episode-11 cups are declined."
 },
